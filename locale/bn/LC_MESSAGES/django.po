msgstr "তারিখটি অনেক আগের। সালটি দেখে নিন।"

#: rewards/forms.py
msgid "You already logged a donation on this date."
msgstr "এই তারিখে আপনি ইতিমধ্যে একটি রক্তদান লিপিবদ্ধ করেছেন।"

#: rewards/forms.py
msgid "Use a first name or initials only. Please do not enter record numbers or IDs."
msgstr "শুধু নামের প্রথম অংশ বা আদ্যক্ষর দিন। রেকর্ড নম্বর বা আইডি দেবেন না।"

#: rewards/forms.py
msgid "You already posted this request. Open \"My requests\" to update or close it."
msgstr "আপনি এই অনুরোধ ইতিমধ্যে জানিয়েছেন। হালনাগাদ বা বন্ধ করতে \"আমার অনুরোধ\" খুলুন।"

#: rewards/forms.py
msgid "Pick a place from the list, or type its name."
msgstr "তালিকা থেকে একটি স্থান বেছে নিন, অথবা নাম লিখুন।"

#: rewards/forms.py
msgid "Pick a date within the next %(n)s days."
msgstr "আগামী %(n)s দিনের মধ্যের একটি তারিখ বেছে নিন।"

#: rewards/forms.py
msgid "You have posted a lot of requests today. Please try again tomorrow."
msgstr "আজ আপনি অনেক অনুরোধ জানিয়েছেন। কাল আবার চেষ্টা করুন।"

#: rewards/forms.py
msgid "%(place)s is in %(actual)s, not %(chosen)s."
msgstr "%(place)s %(actual)s-এ, %(chosen)s-এ নয়।"

#: rewards/forms.py
msgid "Optional. First name or initials only"
msgstr "ঐচ্ছিক। শুধু নামের প্রথম অংশ বা আদ্যক্ষর"

#: rewards/forms.py
msgid "Optional. Ward, bed, or anything a donor should know"
msgstr "ঐচ্ছিক। ওয়ার্ড, বেড, অথবা রক্তদাতার জানা দরকার এমন কিছু"

