#: rewards/directory.py
msgid "You can't contact yourself."
msgstr "আপনি নিজেকে যোগাযোগের অনুরোধ পাঠাতে পারবেন না।"

#: rewards/directory.py
msgid "This donor can't take requests right now."
msgstr "এই রক্তদাতা এখন অনুরোধ নিতে পারছেন না।"

#: rewards/directory.py
msgid "This donor is not in the directory."
msgstr "এই রক্তদাতা তালিকায় নেই।"

#: rewards/directory.py
msgid "This donor already accepted. Their number is in your inbox."
msgstr "এই রক্তদাতা ইতিমধ্যে রাজি হয়েছেন। তাঁর নম্বর আপনার ইনবক্সে আছে।"

#: rewards/directory.py rewards/directory_views.py
msgid "You already asked this donor. Please wait for an answer."
msgstr "আপনি এই রক্তদাতাকে ইতিমধ্যে অনুরোধ করেছেন। উত্তরের জন্য অপেক্ষা করুন।"

#: rewards/directory.py
msgid "You have sent a lot of requests today. Please try again tomorrow."
msgstr "আজ আপনি অনেক অনুরোধ পাঠিয়েছেন। কাল আবার চেষ্টা করুন।"

#: rewards/directory.py
msgid "You have %(n)s requests waiting for an answer. Wait for a reply before asking more people."
msgstr "আপনার %(n)sটি অনুরোধ উত্তরের অপেক্ষায় আছে। আরও মানুষকে অনুরোধ করার আগে উত্তরের জন্য অপেক্ষা করুন।"

#: rewards/directory.py
msgid "This donor declined recently. You can ask again after %(n)s days."
msgstr "এই রক্তদাতা সম্প্রতি অনুরোধ ফিরিয়ে দিয়েছেন। %(n)s দিন পর আবার অনুরোধ করতে পারবেন।"

#: rewards/directory.py
msgid "This donor isn't sharing their number any more. You can ask again after %(n)s days."
msgstr "এই রক্তদাতা আর নিজের নম্বর জানাচ্ছেন না। %(n)s দিন পর আবার অনুরোধ করতে পারবেন।"

#: rewards/directory_views.py
msgid "Blocked. They cannot send you requests or see your number, and they were not told."
msgstr "ব্লক করা হয়েছে। তিনি আপনাকে অনুরোধ পাঠাতে বা আপনার নম্বর দেখতে পারবেন না, আর তাঁকে জানানোও হয়নি।"

#: rewards/directory_views.py
msgid "Unblocked. They can send you requests again."
msgstr "ব্লক তুলে নেওয়া হয়েছে। তিনি আবার আপনাকে অনুরোধ পাঠাতে পারবেন।"

#: rewards/directory_views.py
msgid "Request sent. Their number is shared only if they accept."
msgstr "অনুরোধ পাঠানো হয়েছে। তিনি রাজি হলেই কেবল তাঁর নম্বর জানানো হবে।"

#: rewards/directory_views.py
msgid "You already answered this request."
msgstr "আপনি এই অনুরোধের উত্তর ইতিমধ্যে দিয়েছেন।"

#: rewards/directory_views.py
msgid "Done. Your number is hidden again. They were not given a reason."
msgstr "হয়ে গেছে। আপনার নম্বর আবার লুকানো হয়েছে। তাঁকে কোনো কারণ জানানো হয়নি।"

#: rewards/directory_views.py
msgid "You were not sharing your number with them."
msgstr "আপনি তাঁকে নিজের নম্বর জানাননি।"

#: rewards/directory_views.py
msgid "Choose accept or decline."
msgstr "গ্রহণ বা প্রত্যাখ্যান বেছে নিন।"

#: rewards/forms.py
msgid "-- Other (type below) --"
msgstr "-- অন্য (নিচে লিখুন) --"

#: rewards/forms.py
msgid "-- none --"
msgstr "-- কিছু নেই --"

#: rewards/forms.py
